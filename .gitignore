# Vite files
vite.config.js.timestamp-*
vite.config.ts.timestamp-*
.vite/

# Playwright E2E — saved Clerk sessions (secrets) + generated reports.
# Patterns are anchored to apps/web because a mid-pattern slash anchors to this
# file's dir (repo root), so a bare `e2e/.auth/` would NOT match the nested path.
apps/web/e2e/.auth/
apps/web/test-results/
apps/web/playwright-report/
apps/web/playwright/.cache/

# scienium — derived pixel-art artifacts (sources + scripts are tracked)
art/preview/
art/scene_*.png
art/sheet_*.png
__pycache__/

# macOS
.DS_Store

# Local Claude Code tooling (machine-specific)
.claude/launch.json
.mcp.json

# Feature-pipeline run output (transient; tooling in .claude/agents + .claude/commands is tracked)
.claude/pipeline/
.claude/tmp/

# Third-party design/skills toolkit — machine-level, never commit into the repo.
# (A prior branch accidentally committed ~350 of these files across three dirs.)
# Already-tracked project skills stay tracked; this only blocks the auto-installed
# toolkit + its lockfile. Add a genuinely new project skill with `git add -f`.
skills-lock.json
.github/skills/
.agents/skills/
.claude/skills/

# Python virtualenvs
.venv/
art/.venv/
