# Clerk Authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/onboarding

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nova_lab

# Anthropic (used directly by the Next.js API routes)
ANTHROPIC_API_KEY=sk-ant-...

# Firecrawl (used by sync-deadlines to scrape fair websites)
FIRECRAWL_API_KEY=fc-...

# Cloudflare R2 (PDF + asset storage)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=nova-lab-assets
R2_PUBLIC_URL=https://assets.nova-lab.app

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Showcase view fingerprinting (REQUIRED in production, >=16 chars). A dedicated
# random salt for the per-day, per-visitor view hash. Generate one, e.g.:
#   openssl rand -hex 32
VIEW_FINGERPRINT_SALT=

# Distributed rate limiting (OPTIONAL). When both are set, rate-limit counters
# live in Upstash Redis so limits hold across instances; otherwise an in-process
# (per-instance) limiter is used. https://upstash.com
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Trusted client-IP header for rate limiting (OPTIONAL). Defaults to
# cf-connecting-ip → x-real-ip → x-forwarded-for. Set if your edge uses another.
# RATE_LIMIT_IP_HEADER=cf-connecting-ip

# Scheduled jobs (REQUIRED for Field Dispatch pre-generation + the daily
# fair-deadline notification engine). Vercel Cron sends this as a Bearer token;
# the /api/cron/* routes reject any request without it (and 503 if it's unset).
#   openssl rand -hex 32
CRON_SECRET=

# Notification email (OPTIONAL). When RESEND_API_KEY is set, students who opt in
# to email reminders receive deadline/urgency emails via Resend; otherwise the
# in-app bell is the only channel (no email infra required). https://resend.com
RESEND_API_KEY=
# NOTIFICATION_EMAIL_FROM="NOVA Lab <notifications@nova-lab.app>"

# E2E test-mode flags (set to 1 to skip real LLM calls in E2E; never use in prod)
# E2E_SKIP_LLM=1

# E2E test accounts (Playwright + @clerk/testing). Three EXISTING Clerk dev users
# with email+password sign-in enabled; identifier = the Clerk username or email.
# Used only by `pnpm --filter web test:e2e`. leader/student share one lab.
E2E_LEADER_IDENTIFIER=
E2E_LEADER_PASSWORD=
E2E_STUDENT_IDENTIFIER=
E2E_STUDENT_PASSWORD=
E2E_TEACHER_IDENTIFIER=
E2E_TEACHER_PASSWORD=
