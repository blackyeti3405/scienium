# Clerk Authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FORCE_REDIRECT_URL=/onboarding

# Database (Supabase Postgres)
# Two connection strings from the Supabase dashboard (Project -> Connect). Prisma reads
# DATABASE_URL at runtime and DIRECT_URL for migrations (see docs/SETUP.md section 4).
#   DATABASE_URL = Transaction-mode pooler (port 6543) for app runtime. The pgbouncer
#                  flag is REQUIRED so Prisma works through PgBouncer. connection_limit=1
#                  suits serverless; for a long-running LOCAL dev server raise it (e.g.
#                  connection_limit=10) or concurrent page-load requests hit P2024 pool
#                  timeouts. (Note: Supabase free-tier projects auto-pause when idle —
#                  "Can't reach database server" usually means: resume it in the dashboard.)
#   DIRECT_URL   = Session-mode pooler (port 5432), used only by `prisma migrate` / `db push`.
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-1-[region].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-1-[region].pooler.supabase.com:5432/postgres"
# Local Docker Postgres alternative (infra/docker-compose.yml) — point BOTH at it instead:
#   DATABASE_URL="postgresql://postgres:postgres@localhost:5432/scienium"
#   DIRECT_URL="postgresql://postgres:postgres@localhost:5432/scienium"

# Anthropic (used directly by the Next.js API routes: paper metadata, quizzes, chat,
# lab-type classification, relevance checks)
ANTHROPIC_API_KEY=sk-ant-...

# Discovery — Papers tab scholarly source APIs (arXiv + PubMed via OpenAlex). All
# OPTIONAL: search/citations work keyless, but the anonymous pools rate-limit (503s)
# and a free key stops that. NO AI here — deterministic keyword search + factual
# citation edges only.
#   OpenAlex key:  https://openalex.org/rest-api
#   NCBI key:      https://www.ncbi.nlm.nih.gov/account/  (Settings -> API Key)
OPENALEX_API_KEY=
# OPENALEX_MAILTO=you@example.com   # OPTIONAL — joins OpenAlex's faster "polite pool"
NCBI_API_KEY=
# NCBI_EMAIL=you@example.com        # OPTIONAL — identifies your app to NCBI E-utilities

# Firecrawl (used by sync-deadlines to scrape fair websites)
FIRECRAWL_API_KEY=fc-...

# Cloudflare R2 (PDF + project-log photo + showcase asset storage)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=nova-lab-assets

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Showcase view fingerprinting (REQUIRED in production, >=16 chars). A dedicated
# random salt for the per-day, per-visitor view hash. Generate one, e.g.:
#   openssl rand -hex 32
VIEW_FINGERPRINT_SALT=

# Distributed rate limiting (OPTIONAL). When both are set, rate-limit counters
# live in Upstash Redis so limits hold across instances; otherwise an in-process
# (per-instance) limiter is used. https://upstash.com
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Trusted client-IP header for rate limiting (OPTIONAL). Defaults to
# cf-connecting-ip → x-real-ip → x-forwarded-for. Set if your edge uses another.
# RATE_LIMIT_IP_HEADER=cf-connecting-ip

# Scheduled jobs (REQUIRED for the daily fair-deadline notification engine).
# Vercel Cron sends this as a Bearer token;
# the /api/cron/* routes reject any request without it (and 503 if it's unset).
#   openssl rand -hex 32
CRON_SECRET=

# Notification email (OPTIONAL). When RESEND_API_KEY is set, students who opt in
# to email reminders receive deadline/urgency emails via Resend; otherwise the
# in-app bell is the only channel (no email infra required). https://resend.com
RESEND_API_KEY=
# NOTIFICATION_EMAIL_FROM="scienium <notifications@scienium.app>"

# E2E test-mode flags (set E2E_SKIP_LLM=1 to skip real LLM calls in E2E; never use in prod)
# E2E_SKIP_LLM=1
# E2E_MOCK_SOURCES=1   # OPTIONAL — stubs arXiv/PubMed/OpenAlex with fixtures for the
#                      # Papers-tab E2E spec. Set ONLY in the Playwright webServer env,
#                      # NEVER in .env.local — the dev server reads it too and would then
#                      # serve fixtures instead of real papers.
# E2E_PORT=3100        # OPTIONAL — port the E2E web server uses (default in playwright.config.ts)
# E2E_WORKERS=1        # OPTIONAL — shared accounts/DB require serial execution by default

# E2E test accounts (Playwright + @clerk/testing). Three EXISTING Clerk dev users
# with email+password sign-in enabled; identifier = the Clerk username or email.
# Used only by `pnpm --filter web test:e2e`. leader/student share one lab.
E2E_LEADER_IDENTIFIER=
E2E_LEADER_PASSWORD=
E2E_STUDENT_IDENTIFIER=
E2E_STUDENT_PASSWORD=
E2E_TEACHER_IDENTIFIER=
E2E_TEACHER_PASSWORD=
