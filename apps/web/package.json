{
  "name": "web",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "node scripts/gen-sprite-versions.mjs && NODE_OPTIONS='--dns-result-order=ipv4first' next dev",
    "build": "prisma generate && node scripts/gen-sprite-versions.mjs && next build",
    "//build": "`prisma generate` leads because the client is generated INTO node_modules, which is gitignored. A host that only runs install+build (Vercel) therefore has no @prisma/client types, every query result collapses to `{}`, and the build dies on the first `team.id`. CI has this as a separate step; putting it in the build script covers every host. `postinstall` also runs it, for anyone who builds by other means.",
    "postinstall": "prisma generate",
    "start": "NODE_OPTIONS='--dns-result-order=ipv4first' next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "gen:sprite-versions": "node scripts/gen-sprite-versions.mjs",
    "check:integrity": "node scripts/check-text-integrity.mjs && node lib/ops/codex/scripts/build-codex-tracks.mjs --check",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "codex:build": "node lib/ops/codex/scripts/build-codex-tracks.mjs",
    "codex:merge": "node lib/ops/codex/scripts/merge-codex-segments.mjs",
    "test:e2e": "E2E_BUILD=1 playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:file": "node scripts/test-e2e-file.mjs",
    "seed:e2e": "node --env-file=.env.local --disable-warning=MODULE_TYPELESS_PACKAGE_JSON prisma/seed-e2e.mjs",
    "reset:e2e": "node --env-file=.env.local prisma/reset-e2e.mjs",
    "seed:spells": "node --env-file=.env.local --disable-warning=MODULE_TYPELESS_PACKAGE_JSON prisma/seed-spells.mjs",
    "seed:dev-pvp": "node --env-file=.env.local prisma/seed-dev-pvp.mjs",
    "verify:rls": "node --env-file=.env.local scripts/verify-rls.mjs",
    "verify:e2e": "node --env-file=.env.local --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/verify-e2e-db.mjs",
    "verify:migration-preflights": "node --env-file=.env.local scripts/verify-migration-preflights.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.104.2",
    "@aws-sdk/client-s3": "^3.1065.0",
    "@aws-sdk/s3-request-presigner": "^3.1065.0",
    "@clerk/nextjs": "^7.5.20",
    "@prisma/client": "^5.18.0",
    "@scienium/shared-types": "workspace:*",
    "@sentry/nextjs": "^10.66.0",
    "@tiptap/extensions": "^3.27.1",
    "@tiptap/pm": "^3.27.1",
    "@tiptap/react": "^3.27.1",
    "@tiptap/starter-kit": "^3.27.1",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "fast-xml-parser": "^5.9.3",
    "firecrawl": "^4.28.1",
    "lucide-react": "^0.436.0",
    "next": "^15.5.20",
    "pyodide": "314.0.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "recharts": "^2.12.7",
    "remark-gfm": "^4.0.1",
    "sanitize-html": "^2.17.5",
    "server-only": "^0.0.1",
    "sharp": "^0.33.5",
    "tailwind-merge": "^2.5.2",
    "tailwindcss-animate": "^1.0.7",
    "tiptap-markdown": "^0.9.0",
    "unpdf": "^1.6.2",
    "video.js": "^8.17.1",
    "zod": "^3.23.8",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@clerk/testing": "^2.2.10",
    "@playwright/test": "^1.61.0",
    "@scienium/config": "workspace:*",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "^2.16.1",
    "@types/video.js": "^7.3.58",
    "@vitest/coverage-v8": "4.1.9",
    "autoprefixer": "^10.4.20",
    "eslint": "^8",
    "eslint-config-next": "^15.5.20",
    "postcss": "^8.5.10",
    "prisma": "^5.18.0",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.5.4",
    "vitest": "^4.1.9"
  }
}
