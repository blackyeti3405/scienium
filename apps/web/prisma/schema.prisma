// Self-check scoring driven off the `ISEF_RUBRIC` literal (lib/fairs/isef-rubric.ts),
// NOT the RubricVersion/RubricCriterion/RubricSelfAssessment tables above — those
// require a RubricCriterion seed (hard FK) that this feature deliberately avoids.
// `criterionKey` is derived at read/write time as `"${track}:${numeral}"` (e.g.
// "science:III"); the per-criterion max is looked up from the literal, not stored
// here. One row per team per criterion PER SCORER ROLE (upsert target for PUT) —
// `scorerRole` (Feature F10 — teacher rubric scoring) discriminates the student
// self-check row from the teacher-scored row for the same (team, criterion), so
// the two coexist instead of colliding into one overwritten row. Existing rows
// default/backfill to 'student' (they were all authored by students pre-F10).
model TeamRubricScore {
  id              String           @id @default(cuid())
  teamId          String           @map("team_id")
  track           RubricTrack
  criterionKey    String           @map("criterion_key") // e.g. "science:III"
  score           Int // 0..maxScore for that criterion (validated server-side against ISEF_RUBRIC)
  notes           String?
  scorerRole      RubricScorerRole @default(student) @map("scorer_role")
  updatedByUserId String           @map("updated_by_user_id")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  team            Team             @relation(fields: [teamId], references: [id])
  updatedBy       User             @relation(fields: [updatedByUserId], references: [id])

  @@unique([teamId, criterionKey, scorerRole])
  @@map("team_rubric_scores")
}

enum RubricTrack {
