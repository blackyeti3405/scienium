  previousYearEventId  String?     @map("previous_year_event_id")

  fair Fair @relation(fields: [fairId], references: [id])

  // One event row per fair-year. Backstops the seeder's createMany(skipDuplicates)
  // against cross-process races that previously mass-duplicated events.
  @@unique([fairId, year])
  @@map("fair_events")
}

enum EventStatus {
