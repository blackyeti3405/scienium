// ─── Field Codex (Feature F13) ──────────────────────────────────────────────
// Track → Core/Branch → Unit → Lesson curriculum. Content itself is typed TS
// (apps/web/lib/ops/codex/**) — these tables are only the per-student
// progress ledger, the daily-cap rollup, and the cached team study plan.

// Per-student, per-lesson progress — the once-ever KP claim ledger.
// `bestScore`/`kpAwarded` are high-water marks (never lowered by a weaker
// retake), mirroring PaperProficiency. `completed` flips true on the first
// pass; a later re-pass may raise `bestScore` further but never re-pays KP.
model CodexLessonProgress {
  userId      String    @map("user_id")
  teamId      String    @map("team_id")
  trackSlug   String    @map("track_slug")
  lessonId    String    @map("lesson_id")
  completed   Boolean   @default(false)
  bestScore   Int       @default(0) @map("best_score")
  kpAwarded   Int       @default(0) @map("kp_awarded")
  completedAt DateTime? @map("completed_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])
  team Team @relation(fields: [teamId], references: [id])

  @@id([userId, teamId, trackSlug, lessonId])
  @@index([userId, teamId, trackSlug])
  @@map("codex_lesson_progress")
}

// Daily-cap rollup, PER STUDENT (unlike DiscoveryKpDay which is per-team) —
// counts first-time lesson COMPLETIONS (not KP), enforced atomically at the
// route so a student cannot slip a 4th first-time completion past the cap.
model CodexKpDay {
  id               String   @id @default(cuid())
  userId           String   @map("user_id")
  teamId           String   @map("team_id")
  day              DateTime @db.Date
  lessonsCompleted Int      @default(0) @map("lessons_completed")
  updatedAt        DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])
  team Team @relation(fields: [teamId], references: [id])

  @@unique([userId, teamId, day])
  @@map("codex_kp_days")
}

// ─── Vocabulary builder ───────────────────────────────────────────────────
// Per-student spaced-repetition deck of terms EXTRACTED from the team's own
// Paper.fullText/abstract (Schwartz-Hearst acronym pairing, repeated
// technical n-grams, and authored-dictionary hits — see lib/literature/
// vocab.ts). Zero LLM: nothing here is ever model-generated.

enum VocabSource {
  research_glossary
  stats_guide
  methods_guide
  data_quality_guide
  paper_definition // the paper itself defines it (validated acronym expansion)
  paper_context // no grounded definition exists — show the paper's own sentence
  llm_definition // written at build time by vocab-curate.ts, grounded in the paper's own sentence (kept as `quote`)

  @@map("vocab_source")
}

// Per-STUDENT deck card (like PaperProficiency, each member builds their own),
// lifted from a team-scoped Paper. `definition` is ALWAYS grounded: either an
// authored dictionary entry (`sourceEntryId`) or verbatim paper text (`quote`).
// Nothing here is ever model-generated.
//
// `onDelete: Cascade` on `paperId` is intentional: deleting a paper drops the
// cards lifted from it. If the term also appears in a surviving paper, the
// next "Build deck" re-adds it — self-healing.
// Once-ever curation marker: one row = "this student's deck has already paid
// the curation call for this paper". The build route skips marked papers, so
// re-building never re-bills a paper — curation deliberately rejects trivial
// candidates, so "all candidates carded" (the old skip test) is never true and
// cannot serve as the marker. Written only after a curation call returns terms.
model VocabPaperCuration {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  paperId   String   @map("paper_id")
  createdAt DateTime @default(now()) @map("created_at")

  user  User  @relation(fields: [userId], references: [id])
  paper Paper @relation(fields: [paperId], references: [id], onDelete: Cascade)

  @@unique([userId, paperId])
  @@map("vocab_paper_curations")
}

model VocabCard {
  id             String      @id @default(cuid())
  userId         String      @map("user_id")
  teamId         String      @map("team_id")
  paperId        String      @map("paper_id")
  termKey        String      @map("term_key") // canonicalKey() — the dedupe key
  term           String
  aliases        String[]    @default([])
  definition     String
  source         VocabSource
  sourceEntryId  String?     @map("source_entry_id")
  quote          String? // VERBATIM sentence from the paper
  box            Int         @default(1)
  dueAt          DateTime    @map("due_at")
  lastReviewedAt DateTime?   @map("last_reviewed_at")
  reviewCount    Int         @default(0) @map("review_count")
  lapses         Int         @default(0)
  kpAwarded      Int         @default(0) @map("kp_awarded") // once-ever high-water (0 → VOCAB_KP_PER_TERM)
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  user  User  @relation(fields: [userId], references: [id])
  team  Team  @relation(fields: [teamId], references: [id])
  paper Paper @relation(fields: [paperId], references: [id], onDelete: Cascade)

  // One card per term per student PER LAB (REFACTOR2 P2-S4). This was
  // (userId, termKey) — global per student — while deck/review/delete were all
  // team-scoped, so a student in a second lab had their build filtered against
  // a deck they could not see and the term never appeared at all.
  @@unique([userId, teamId, termKey])
  @@index([userId, teamId, dueAt]) // "today's due cards"
  @@index([paperId])
  @@map("vocab_cards")
}

// Daily KP cap ledger, PER STUDENT — a direct copy of CodexKpDay's shape and
// its atomic WHERE-gated increment. Counts KP (not cards) so the cap is a
// money cap.
model VocabKpDay {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  teamId    String   @map("team_id")
  day       DateTime @db.Date
  kpAwarded Int      @default(0) @map("kp_awarded")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])
  team Team @relation(fields: [teamId], references: [id])

  @@unique([userId, teamId, day])
  @@map("vocab_kp_days")
}

// Cached "Study Plan" — one Haiku classification of the team's topic/research
// idea/plan into recommended tracks + branches, re-runnable with a daily cap.
// 1:1 on Team. `manualTrackSlugs` lets a student add tracks the classifier
// didn't recommend, without another LLM call.
model TeamStudyPlan {
  teamId            String    @id @map("team_id")
  tracksJson        Json      @map("tracks_json")
  sourceHash        String    @map("source_hash")
  // The source hash the CURRENT in-flight generation is working from, stamped
  // when the daily slot is reserved (P1-S9). The commit is a compare-and-set on
  // it, so a slow generation started against an older topic can no longer land
  // on top of a newer one that already finished.
  pendingSourceHash String?   @map("pending_source_hash")
  generatedAt       DateTime  @default(now()) @map("generated_at")
  runsToday         Int       @default(0) @map("runs_today")
  runsDay           DateTime? @map("runs_day") @db.Date
  manualTrackSlugs  String[]  @default([]) @map("manual_track_slugs")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  team Team @relation(fields: [teamId], references: [id])

  @@map("team_study_plans")
}

// ─── Study with Vega (Feature F18) ────────────────────────────────────────────

// A team-shared, persistent study-chat thread with Vega, grounded in the
// team's own project (topic/research idea/plan/recent log — see
// lib/ops/vega-study-context.ts). TEAM-SHARED (not per-user) like
// ProjectLog/ResearchPlan: the whole team sees one continuous thread. `userId`
// still records the author of each turn (attribution only) — the GET query
// filters by teamId ONLY. Contrast with PaperChatMessage, which IS per-user
// because paper comprehension is graded per-student.
model VegaStudyMessage {
  id             String            @id @default(cuid())
  teamId         String            @map("team_id")
  userId         String            @map("user_id")
  role           MessageRole
  content        String
  // See PaperChatMessage: server-owned turn lifecycle (pending → complete/error).
  status         ChatMessageStatus @default(complete)
  requestId      String?           @map("request_id")
  error          String?
  tokenUsageJson Json?             @map("token_usage_json")
  createdAt      DateTime          @default(now()) @map("created_at")

  team Team @relation(fields: [teamId], references: [id])
  user User @relation(fields: [userId], references: [id])

  @@index([teamId, createdAt])
  @@map("vega_study_messages")
}
