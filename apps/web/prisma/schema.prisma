generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Users & Org ─────────────────────────────────────────────────────────────

model User {
  id          String   @id @default(cuid())
  clerkUserId String   @unique @map("clerk_user_id")
  name        String
  email       String   @unique
  schoolId    String?  @map("school_id")
  classId     String?  @map("class_id")
  role        UserRole @default(student)
  isMinor     Boolean  @default(true) @map("is_minor")
  createdAt   DateTime @default(now()) @map("created_at")

  school               School?                 @relation(fields: [schoolId], references: [id])
  class                Class?                  @relation(fields: [classId], references: [id])
  classesTeaching      Class[]                 @relation("classTeacher")
  teamMemberships      TeamMember[]
  projectLogEntries    ProjectLog[]
  projectLogEdits      ProjectLog[]            @relation("projectLogEditor")
  discoveryNodes       DiscoveryNode[]
  fieldDispatchResp    FieldDispatchResponse[]
  expertiseAttempts    ExpertiseAttempt[]
  expertiseExams       ExpertiseExam[]
  shopPurchases        TeamShopBuilding[]
  miniGamePlays        MiniGamePlay[]
  rubricAssessments    RubricSelfAssessment[]
  activityFeedEntries  ActivityFeed[]
  paperProficiencies   PaperProficiency[]
  advanceRequestsMade  PhaseAdvanceRequest[]   @relation("advanceRequester")
  advanceReviews       PhaseAdvanceRequest[]   @relation("advanceReviewer")
  teacherFeedbackGiven TeacherFeedback[]       @relation("teacherFeedbackAuthor")
  notifications        Notification[]
  notificationPref     NotificationPref?
  experiments          Experiment[]            @relation("experimentAuthor")

  @@map("users")
}

enum UserRole {
  student
  teacher
  admin

  @@map("user_role")
}

// A school is created on demand by name during onboarding (find-or-create), so
// `adminId` is optional — a pilot student can register their high school without
// a pre-provisioned admin account.
model School {
  id      String  @id @default(cuid())
  name    String  @unique
  adminId String? @map("admin_id")
  users   User[]
  classes Class[]

  @@map("schools")
}

// A teacher's classroom. Students join with the reusable `joinCode` (unlike the
// single-use team invite, a classroom code is long-lived so a whole class can
// redeem it). The teacher owns it via `teacherId`.
model Class {
  id        String   @id @default(cuid())
  schoolId  String   @map("school_id")
  name      String
  teacherId String   @map("teacher_id")
  joinCode  String?  @unique @map("join_code")
  createdAt DateTime @default(now()) @map("created_at")
  school    School   @relation(fields: [schoolId], references: [id])
  teacher   User     @relation("classTeacher", fields: [teacherId], references: [id])
  users     User[]

  @@map("classes")
}

// ─── Teams ───────────────────────────────────────────────────────────────────

model Team {
  id            String       @id @default(cuid())
  name          String
  teamLeadId    String       @map("team_lead_id")
  labType       LabType?     @map("lab_type")
  topic         String?
  phase         ProjectPhase @default(discovery)
  // Cap on how many students may join this lab. Building costs scale with the
  // live member count (lib/shop.ts), so a bigger team earns more KP but pays more.
  maxMembers    Int          @default(3) @map("max_members")
  // US location (Feature 3) — drives Science Fair matching. ZIP is captured at
  // onboarding; `locationState` is the 2-letter code derived from it (lib/fairs/zip.ts).
  locationZip   String?      @map("location_zip")
  locationState String?      @map("location_state")
  // Geocoded coordinates for the team's ZIP — more accurate than state centroid
  // for ordering regional fairs. Set at onboarding / location update via Nominatim.
  locationLat   Float?       @map("location_lat")
  locationLng   Float?       @map("location_lng")
  // One-sentence research idea submitted at the end of lit review — used to
  // auto-assign lab type via Haiku classification before entering research_planning.
  researchIdea  String?      @map("research_idea")
  createdAt     DateTime     @default(now()) @map("created_at")

  members         TeamMember[]
  currency        TeamCurrency?
  buildings       TeamBuilding[]
  shopBuildings   TeamShopBuilding[]
  expertiseExams  ExpertiseExam[]
  discoveryNodes  DiscoveryNode[]
  topicInterests  TopicInterest[]
  papers          Paper[]
  projectLogs     ProjectLog[]
  invites         TeamInvite[]
  researchPlan    ResearchPlan?
  ideaChecks      IdeaCheck[]
  pvpTeam         PvpTeam?
  pvpTrophies     PvpTrophies?
  pvpBattleQuota  PvpBattleQuota[]
  showcase        Showcase?
  formStatuses    TeamFormStatus[]
  activityFeed    ActivityFeed[]
  advanceRequests PhaseAdvanceRequest[]
  teacherFeedback TeacherFeedback[]
  notifications   Notification[]
  experiments     Experiment[]

  @@map("teams")
}

// A single-use join code a lead generates so other students can join the lab.
// Consumed by POST /api/team/join, which enforces Team.maxMembers.
model TeamInvite {
  id              String    @id @default(cuid())
  code            String    @unique
  teamId          String    @map("team_id")
  createdByUserId String    @map("created_by_user_id")
  expiresAt       DateTime  @map("expires_at")
  usedByUserId    String?   @map("used_by_user_id")
  usedAt          DateTime? @map("used_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  team            Team      @relation(fields: [teamId], references: [id])

  @@map("team_invites")
}

model TeamMember {
  userId   String     @map("user_id")
  teamId   String     @map("team_id")
  role     MemberRole @default(member)
  joinedAt DateTime   @default(now()) @map("joined_at")
  user     User       @relation(fields: [userId], references: [id])
  team     Team       @relation(fields: [teamId], references: [id])

  @@id([userId, teamId])
  @@map("team_members")
}

enum MemberRole {
  lead
  member

  @@map("member_role")
}

enum LabType {
  biocore
  chemworks
  volt_lab
  terrabase
  mindframe
  axiom

  @@map("lab_type")
}

enum ProjectPhase {
  discovery
  lab_selection
  literature_review
  research_planning
  working
  showcase

  @@map("project_phase")
}

// ─── Currency ────────────────────────────────────────────────────────────────

model TeamCurrency {
  teamId         String   @id @map("team_id")
  kp             Int      @default(0)
  clearanceLevel Int      @default(0) @map("clearance_level")
  lc             Int      @default(0)
  updatedAt      DateTime @updatedAt @map("updated_at")
  team           Team     @relation(fields: [teamId], references: [id])

  @@map("team_currency")
}

// ─── Discovery ───────────────────────────────────────────────────────────────

model DiscoveryNode {
  id              String          @id @default(cuid())
  teamId          String          @map("team_id")
  parentId        String?         @map("parent_id")
  sourceType      DiscoverySource @map("source_type")
  wikipediaTitle  String?         @map("wikipedia_title")
  youtubeVideoId  String?         @map("youtube_video_id")
  youtubeTitle    String?         @map("youtube_title")
  paperId         String?         @map("paper_id")
  starred         Boolean         @default(false)
  visitedByUserId String          @map("visited_by_user_id")
  visitedAt       DateTime        @default(now()) @map("visited_at")

  team      Team            @relation(fields: [teamId], references: [id])
  visitedBy User            @relation(fields: [visitedByUserId], references: [id])
  parent    DiscoveryNode?  @relation("tree", fields: [parentId], references: [id])
  children  DiscoveryNode[] @relation("tree")

  @@map("discovery_nodes")
}

enum DiscoverySource {
  wikipedia
  youtube
  paper

  @@map("discovery_source")
}

model TopicInterest {
  id              String   @id @default(cuid())
  teamId          String   @map("team_id")
  text            String
  createdByUserId String   @map("created_by_user_id")
  createdAt       DateTime @default(now()) @map("created_at")
  team            Team     @relation(fields: [teamId], references: [id])

  @@map("topic_interests")
}

// ─── Literature ──────────────────────────────────────────────────────────────

model Paper {
  id               String      @id @default(cuid())
  teamId           String      @map("team_id")
  title            String
  authors          String[]
  abstract         String?
  sourceType       PaperSource @map("source_type")
  fileUrl          String?     @map("file_url")
  contentHash      String?     @map("content_hash")
  fullText         String?     @map("full_text")
  // PDF binary lives in Cloudflare R2; `pdfKey` is the object key (see lib/storage.ts).
  // `pdfData` is the legacy in-DB blob, kept only as a fallback for rows uploaded
  // before the R2 migration — new uploads leave it null and a cleanup migration
  // can drop it once all rows are backfilled.
  pdfKey           String?     @map("pdf_key")
  pdfData          Bytes?      @map("pdf_data")
  status           PaperStatus @default(pending)
  uploadedByUserId String      @map("uploaded_by_user_id")
  createdAt        DateTime    @default(now()) @map("created_at")

  team           Team                 @relation(fields: [teamId], references: [id])
  quizSessions   PaperQuizSession[]
  quizAttempts   PaperQuizAttempt[]
  relevanceNotes PaperRelevanceNote[]
  chatMessages   PaperChatMessage[]
  proficiencies  PaperProficiency[]

  @@map("papers")
}

// Per-student proficiency on a single source. Each member demonstrates
// proficiency independently (by passing that source's quiz), and earns KP up to
// 100 per source — so a 3-student lab can earn up to 3× the KP from the same 25
// sources. The literature-review phase gate requires EVERY member to be
// `demonstrated` on all 25 sources (lib/team/advance.ts).
model PaperProficiency {
  paperId      String   @map("paper_id")
  userId       String   @map("user_id")
  demonstrated Boolean  @default(false)
  // Best aggregate quiz score this student has achieved on the source (0-100).
  bestScore    Int      @default(0) @map("best_score")
  // High-water mark of KP this student has already earned from the source (max 100).
  kpAwarded    Int      @default(0) @map("kp_awarded")
  updatedAt    DateTime @updatedAt @map("updated_at")

  paper Paper @relation(fields: [paperId], references: [id])
  user  User  @relation(fields: [userId], references: [id])

  @@id([paperId, userId])
  @@map("paper_proficiency")
}

model PaperChatMessage {
  id        String   @id @default(cuid())
  paperId   String   @map("paper_id")
  userId    String   @map("user_id")
  role      String // 'user' | 'assistant'
  content   String
  createdAt DateTime @default(now()) @map("created_at")
  paper     Paper    @relation(fields: [paperId], references: [id])

  @@index([paperId, userId])
  @@map("paper_chat_messages")
}

enum PaperSource {
  pdf
  text

  @@map("paper_source")
}

enum PaperStatus {
  pending
  processing
  ready
  error

  @@map("paper_status")
}

// A single quiz attempt: a generated set of questions (with keys) and, once
// submitted, the per-question grades and aggregate result.
model PaperQuizSession {
  id            String    @id @default(cuid())
  paperId       String    @map("paper_id")
  userId        String    @map("user_id")
  // [{ id, prompt, focus, key }] — `key` is server-only, never sent to client
  questionsJson Json      @map("questions_json")
  score         Int? // aggregate 0-100, set on grading
  passed        Boolean   @default(false)
  gradedAt      DateTime? @map("graded_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  paper    Paper              @relation(fields: [paperId], references: [id])
  attempts PaperQuizAttempt[]

  @@map("paper_quiz_sessions")
}

model PaperQuizAttempt {
  id         String           @id @default(cuid())
  sessionId  String           @map("session_id")
  paperId    String           @map("paper_id")
  userId     String           @map("user_id")
  question   String
  response   String
  evaluation String
  score      Int              @default(0)
  createdAt  DateTime         @default(now()) @map("created_at")
  paper      Paper            @relation(fields: [paperId], references: [id])
  session    PaperQuizSession @relation(fields: [sessionId], references: [id])

  @@map("paper_quiz_attempts")
}

model PaperRelevanceNote {
  paperId   String   @map("paper_id")
  userId    String   @map("user_id")
  response  String
  createdAt DateTime @default(now()) @map("created_at")
  paper     Paper    @relation(fields: [paperId], references: [id])

  @@id([paperId, userId])
  @@map("paper_relevance_notes")
}

// ─── Research Plan (Feature 2) ───────────────────────────────────────────────

// One research-plan workspace per team. The plan lives in a Google Doc the team
// connects by pasting an "anyone with the link" URL; we fetch the published text
// on demand (lib/research-plan/google-doc.ts — OAuth deferred, see TODO.md). The
// project type/subtype selects the rubric the AI review grades against.
model ResearchPlan {
  teamId            String    @id @map("team_id")
  googleDocUrl      String?   @map("google_doc_url")
  projectType       String?   @map("project_type") // 'engineering' | 'science'
  projectSubtype    String?   @map("project_subtype") // e.g. 'robotics', 'biology'
  lastSyncedText    String?   @map("last_synced_text")
  lastSyncedAt      DateTime? @map("last_synced_at")
  // Latest AI review of the synced plan; replaced on each re-review so it
  // persists across reloads and never piles up.
  lastReviewJson    Json?     @map("last_review_json")
  lastReviewedAt    DateTime? @map("last_reviewed_at")
  // Latest idea-check result ({ verdict, findings }); replaced on each re-run.
  // (The `IdeaCheck` table is only the per-day rate-limit ledger.)
  lastIdeaCheckJson Json?     @map("last_idea_check_json")
  lastIdeaCheckAt   DateTime? @map("last_idea_check_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  team Team @relation(fields: [teamId], references: [id])

  @@map("research_plans")
}

// A run of the "has this idea been done before?" web-search agent. Rate-limited
// to 3/day per team (counted from createdAt).
model IdeaCheck {
  id           String   @id @default(cuid())
  teamId       String   @map("team_id")
  userId       String   @map("user_id")
  // 'novel' | 'refine' | 'reject' — the agent's recommendation.
  verdict      String
  findingsJson Json     @map("findings_json")
  createdAt    DateTime @default(now()) @map("created_at")

  team Team @relation(fields: [teamId], references: [id])

  @@index([teamId, createdAt])
  @@map("idea_checks")
}

// ─── Lab Buildings ───────────────────────────────────────────────────────────

model Building {
  id               String           @id @default(cuid())
  labType          LabType          @map("lab_type")
  name             String
  role             BuildingRole
  description      String
  miniGameCategory MiniGameCategory @map("mini_game_category")

  teamBuildings TeamBuilding[]
  character     Character?

  @@map("buildings")
}

enum BuildingRole {
  starter
  standard
  premium

  @@map("building_role")
}

enum MiniGameCategory {
  identification
  configuration
  prediction
  diagnosis
  optimization
  decoding

  @@map("mini_game_category")
}

model TeamBuilding {
  id                   String    @id @default(cuid())
  teamId               String    @map("team_id")
  buildingId           String    @map("building_id")
  currentLevel         Int       @default(1) @map("current_level")
  lastUpgradedByUserId String?   @map("last_upgraded_by_user_id")
  lastUpgradedAt       DateTime? @map("last_upgraded_at")

  team     Team     @relation(fields: [teamId], references: [id])
  building Building @relation(fields: [buildingId], references: [id])

  @@unique([teamId, buildingId])
  @@map("team_buildings")
}

// A purchasable shop structure a team owns (lib/shop.ts catalog). Unlike
// `TeamBuilding` (which links the seeded PvP `Building` rows), shop buildings are
// config-keyed, so ownership is tracked by the catalog `buildingKey`. Purchases
// deduct KP and require the team's `clearanceLevel` to meet the building's tier —
// this is the "ceiling" Proof of Expertise pushes against (lib/clearance).
model TeamShopBuilding {
  id                String   @id @default(cuid())
  teamId            String   @map("team_id")
  buildingKey       String   @map("building_key")
  purchasedByUserId String   @map("purchased_by_user_id")
  purchasedAt       DateTime @default(now()) @map("purchased_at")

  team        Team @relation(fields: [teamId], references: [id])
  purchasedBy User @relation(fields: [purchasedByUserId], references: [id])

  @@unique([teamId, buildingKey])
  @@map("team_shop_buildings")
}

// ─── Daily Activities ─────────────────────────────────────────────────────────

model FieldDispatchContent {
  id                 String   @id @default(cuid())
  labType            LabType  @map("lab_type")
  body               String
  reflectionQuestion String   @map("reflection_question")
  publishedDate      DateTime @map("published_date")

  responses FieldDispatchResponse[]

  // One dispatch per lab type per day; the "today" lookup hits this index and
  // the unique pair keeps the weekly cron idempotent (re-run upserts in place).
  @@unique([labType, publishedDate])
  @@index([labType, publishedDate])
  @@map("field_dispatch_content")
}

model FieldDispatchResponse {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  contentId String   @map("content_id")
  response  String
  kpAwarded Int      @map("kp_awarded")
  createdAt DateTime @default(now()) @map("created_at")

  user    User                 @relation(fields: [userId], references: [id])
  content FieldDispatchContent @relation(fields: [contentId], references: [id])

  // A student answers each day's dispatch at most once — the KP award reads this
  // unique pair so a double-submit can't double-pay.
  @@unique([userId, contentId])
  @@map("field_dispatch_responses")
}

// Proof of Expertise — a conversational clearance exam (Feature: Clearance Level).
// One exam attempts to raise the team from its current clearance to `targetLevel`.
// Questions are generated from the team's OWN project context at escalating depth;
// passing (>= threshold) raises `TeamCurrency.clearanceLevel`. Mirrors the paper
// quiz's session/attempt split (PaperQuizSession / PaperQuizAttempt).
model ExpertiseExam {
  id            String    @id @default(cuid())
  teamId        String    @map("team_id")
  userId        String    @map("user_id")
  // Clearance level this exam attempts to reach (current + 1).
  targetLevel   Int       @map("target_level")
  // [{ id, prompt, focus, key }] — `key` is the server-only grading guidance.
  questionsJson Json      @map("questions_json")
  // In-progress answers ({ [questionId]: response }) + how far the student has
  // got, persisted as they go so an ungraded exam can be RESUMED after closing
  // the panel (rather than regenerating a fresh one). Null until the first answer.
  answersJson   Json?     @map("answers_json")
  progressIndex Int       @default(0) @map("progress_index")
  score         Int? // aggregate 0-100, set on grading
  passed        Boolean   @default(false)
  gradedAt      DateTime? @map("graded_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  team     Team               @relation(fields: [teamId], references: [id])
  user     User               @relation(fields: [userId], references: [id])
  attempts ExpertiseAttempt[]

  @@index([teamId, gradedAt])
  @@map("expertise_exams")
}

model ExpertiseAttempt {
  id         String   @id @default(cuid())
  examId     String   @map("exam_id")
  userId     String   @map("user_id")
  question   String
  response   String
  evaluation String   @default("")
  score      Int      @default(0)
  createdAt  DateTime @default(now()) @map("created_at")

  exam ExpertiseExam @relation(fields: [examId], references: [id])
  user User          @relation(fields: [userId], references: [id])

  @@map("expertise_attempts")
}

model ProjectLog {
  id                 String          @id @default(cuid())
  teamId             String          @map("team_id")
  entryType          ProjectLogEntry @map("entry_type")
  stage              String?
  body               String
  nextSteps          String          @default("") @map("next_steps")
  attendeeIds        String[]        @default([]) @map("attendee_ids")
  artifactUrl        String?         @map("artifact_url")
  attachmentUrls     String[]        @default([]) @map("attachment_urls")
  createdByUserId    String          @map("created_by_user_id")
  createdAt          DateTime        @default(now()) @map("created_at")
  // Logs are shared across the team — anyone may edit. Track the last editor so
  // the entry can show "edited by …" (null until first edited by someone).
  lastEditedByUserId String?         @map("last_edited_by_user_id")
  lastEditedAt       DateTime?       @map("last_edited_at")

  team         Team                  @relation(fields: [teamId], references: [id])
  createdBy    User                  @relation(fields: [createdByUserId], references: [id])
  lastEditedBy User?                 @relation("projectLogEditor", fields: [lastEditedByUserId], references: [id])
  followups    ProjectLogFollowup[]
  references   ProjectLogReference[] @relation("from")
  referencedBy ProjectLogReference[] @relation("to")

  @@map("project_logs")
}

enum ProjectLogEntry {
  progress
  failure

  @@map("project_log_entry")
}

model ProjectLogFollowup {
  id           String     @id @default(cuid())
  projectLogId String     @map("project_log_id")
  question     String
  response     String?
  answeredAt   DateTime?  @map("answered_at")
  createdAt    DateTime   @default(now()) @map("created_at")
  log          ProjectLog @relation(fields: [projectLogId], references: [id], onDelete: Cascade)

  @@map("project_log_followups")
}

model ProjectLogReference {
  projectLogId    String     @map("project_log_id")
  referencesLogId String     @map("references_log_id")
  from            ProjectLog @relation("from", fields: [projectLogId], references: [id])
  to              ProjectLog @relation("to", fields: [referencesLogId], references: [id])

  @@id([projectLogId, referencesLogId])
  @@map("project_log_references")
}

model MiniGamePlay {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  teamId     String   @map("team_id")
  buildingId String   @map("building_id")
  score      Int
  kpAwarded  Int      @map("kp_awarded")
  playedAt   DateTime @default(now()) @map("played_at")
  user       User     @relation(fields: [userId], references: [id])

  @@map("mini_game_plays")
}

// ─── Teacher Dashboard ───────────────────────────────────────────────────────

// A team's request to cross a teacher-gated phase boundary. The figurine system
// was removed; instead the two real-world milestones (starting data collection →
// `working`, advancing to competition → `showcase`) require a teacher to approve
// a request in the teacher dashboard. The earlier literature_review →
// research_planning gate stays auto/self-serve (it's mechanically checkable).
model PhaseAdvanceRequest {
  id                String           @id @default(cuid())
  teamId            String           @map("team_id")
  fromPhase         ProjectPhase     @map("from_phase")
  toPhase           ProjectPhase     @map("to_phase")
  status            ValidationStatus @default(pending)
  note              String?
  requestedByUserId String           @map("requested_by_user_id")
  reviewedByUserId  String?          @map("reviewed_by_user_id")
  reviewedAt        DateTime?        @map("reviewed_at")
  reviewNote        String?          @map("review_note")
  createdAt         DateTime         @default(now()) @map("created_at")

  team        Team  @relation(fields: [teamId], references: [id])
  requestedBy User  @relation("advanceRequester", fields: [requestedByUserId], references: [id])
  reviewedBy  User? @relation("advanceReviewer", fields: [reviewedByUserId], references: [id])

  @@index([teamId, status])
  @@index([status])
  @@map("phase_advance_requests")
}

enum ValidationStatus {
  pending
  approved
  rejected

  @@map("validation_status")
}

// Free-text feedback a teacher attaches to a team (optionally to a specific
// target like a project log or paper). Visible to the team in their own view.
model TeacherFeedback {
  id            String   @id @default(cuid())
  teamId        String   @map("team_id")
  teacherUserId String   @map("teacher_user_id")
  targetType    String   @map("target_type") // 'team' | 'project_log' | 'paper' | 'showcase'
  targetId      String?  @map("target_id")
  body          String
  resolved      Boolean  @default(false)
  createdAt     DateTime @default(now()) @map("created_at")

  team    Team @relation(fields: [teamId], references: [id])
  teacher User @relation("teacherFeedbackAuthor", fields: [teacherUserId], references: [id])

  @@index([teamId])
  @@map("teacher_feedback")
}

// ─── Notifications ───────────────────────────────────────────────────────────

// An in-app notification. `userId` null means the whole team. `dedupeKey` is
// UNIQUE so the daily cron is idempotent — re-running never double-inserts the
// same "regional fair in 7 days" reminder.
model Notification {
  id        String    @id @default(cuid())
  teamId    String    @map("team_id")
  userId    String?   @map("user_id")
  kind      String // 'fair_deadline' | 'urgency' | 'teacher_feedback' | 'phase_reviewed' | 'showcase_reviewed'
  title     String
  body      String
  linkUrl   String?   @map("link_url")
  dedupeKey String    @unique @map("dedupe_key")
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  team Team  @relation(fields: [teamId], references: [id])
  user User? @relation(fields: [userId], references: [id])

  @@index([teamId, createdAt])
  @@map("notifications")
}

model NotificationPref {
  userId       String   @id @map("user_id")
  emailEnabled Boolean  @default(false) @map("email_enabled")
  email        String?
  // Days-before-deadline to fire reminders at (default 30/14/7/1).
  deadlineDays Int[]    @default([30, 14, 7, 1]) @map("deadline_days")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])

  @@map("notification_prefs")
}

// ─── Data Terminal ───────────────────────────────────────────────────────────

// Experiment tracking + graphing (unlocked at `working`). An experiment is a
// titled x/y dataset; measurements are its points, optionally grouped by series.
model Experiment {
  id              String   @id @default(cuid())
  teamId          String   @map("team_id")
  title           String
  description     String   @default("")
  xLabel          String   @default("x") @map("x_label")
  yLabel          String   @default("y") @map("y_label")
  createdByUserId String   @map("created_by_user_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  team         Team          @relation(fields: [teamId], references: [id])
  createdBy    User          @relation("experimentAuthor", fields: [createdByUserId], references: [id])
  measurements Measurement[]

  @@index([teamId])
  @@map("experiments")
}

model Measurement {
  id           String   @id @default(cuid())
  experimentId String   @map("experiment_id")
  series       String   @default("")
  x            Float
  y            Float
  note         String?
  recordedAt   DateTime @default(now()) @map("recorded_at")

  experiment Experiment @relation(fields: [experimentId], references: [id])

  @@index([experimentId])
  @@map("measurements")
}

// ─── Showcase ────────────────────────────────────────────────────────────────

model Showcase {
  id               String           @id @default(cuid())
  teamId           String           @unique @map("team_id")
  slug             String           @unique
  // Short title (≤50 chars) shown as the headline; `title` is the full project
  // title (≤300 chars). Abstract is capped at 250 words (enforced in-route).
  shortTitle       String           @default("") @map("short_title")
  title            String
  abstract         String
  privacyLevel     PrivacyLevel     @default(private) @map("privacy_level")
  publishedAt      DateTime?        @map("published_at")
  lastEditedAt     DateTime         @updatedAt @map("last_edited_at")
  moderationStatus ModerationStatus @default(draft) @map("moderation_status")
  moderationNote   String?          @map("moderation_note")
  moderatedAt      DateTime?        @map("moderated_at")

  team   Team            @relation(fields: [teamId], references: [id])
  assets ShowcaseAsset[]
  views  ShowcaseView[]

  @@map("showcases")
}

enum PrivacyLevel {
  public
  school_only
  link_only
  private

  @@map("privacy_level")
}

enum ModerationStatus {
  draft
  pending_review
  approved
  rejected

  @@map("moderation_status")
}

model ShowcaseAsset {
  id           String    @id @default(cuid())
  showcaseId   String    @map("showcase_id")
  assetType    AssetType @map("asset_type")
  fileUrl      String?   @map("file_url")
  metadataJson Json?     @map("metadata_json")
  uploadedAt   DateTime  @default(now()) @map("uploaded_at")
  showcase     Showcase  @relation(fields: [showcaseId], references: [id])

  @@map("showcase_assets")
}

enum AssetType {
  script
  board // PDF of the project board (required)
  quad_chart // PDF or image quad chart (required)
  video // the required ~2-minute project video (link)
  demo_video // optional additional demo videos (links)
  supplement // optional supplemental-information links
  visual // (legacy, unused)
  report // (legacy, unused)
  repo_link // optional GitHub / code link

  @@map("asset_type")
}

model ShowcaseView {
  id                 String   @id @default(cuid())
  showcaseId         String   @map("showcase_id")
  visitorFingerprint String   @map("visitor_fingerprint")
  viewedAt           DateTime @default(now()) @map("viewed_at")
  showcase           Showcase @relation(fields: [showcaseId], references: [id])

  @@map("showcase_views")
}

// ─── Science Fair Hub ────────────────────────────────────────────────────────

model Fair {
  id           String    @id @default(cuid())
  name         String
  level        FairLevel
  state        String?
  county       String?
  country      String    @default("US")
  websiteUrl   String?   @map("website_url")
  parentFairId String?   @map("parent_fair_id")
  // Representative coordinates (host city / state centre) for nearest-fair
  // matching against a team's location (Feature 3, lib/fairs/match.ts).
  latitude     Float?
  longitude    Float?
  // Stable natural key from the seed dataset, so re-seeding upserts in place.
  seedKey      String?   @unique @map("seed_key")

  events     FairEvent[]
  userAssocs FairUserAssociation[]

  @@map("fairs")
}

enum FairLevel {
  school
  regional
  state
  international
  affiliated

  @@map("fair_level")
}

model FairEvent {
  id                   String      @id @default(cuid())
  fairId               String      @map("fair_id")
  year                 Int
  eventDate            DateTime?   @map("event_date")
  registrationDeadline DateTime?   @map("registration_deadline")
  abstractDeadline     DateTime?   @map("abstract_deadline")
  venue                String?
  status               EventStatus @default(estimated)
  previousYearEventId  String?     @map("previous_year_event_id")

  fair Fair @relation(fields: [fairId], references: [id])

  @@map("fair_events")
}

enum EventStatus {
  confirmed
  estimated

  @@map("event_status")
}

model FairUserAssociation {
  userId       String   @map("user_id")
  fairId       String   @map("fair_id")
  isPrimary    Boolean  @default(false) @map("is_primary")
  registeredAt DateTime @default(now()) @map("registered_at")

  fair Fair @relation(fields: [fairId], references: [id])

  @@id([userId, fairId])
  @@map("fair_user_associations")
}

model RubricVersion {
  id         String            @id @default(cuid())
  fairId     String            @map("fair_id")
  year       Int
  rubricJson Json              @map("rubric_json")
  criteria   RubricCriterion[]

  @@map("rubric_versions")
}

model RubricCriterion {
  id                 String                 @id @default(cuid())
  rubricVersionId    String                 @map("rubric_version_id")
  name               String
  description        String
  maxScore           Int                    @map("max_score")
  checklistItemsJson Json                   @map("checklist_items_json")
  rubricVersion      RubricVersion          @relation(fields: [rubricVersionId], references: [id])
  assessments        RubricSelfAssessment[]

  @@map("rubric_criteria")
}

model RubricSelfAssessment {
  id                String          @id @default(cuid())
  teamId            String          @map("team_id")
  rubricCriterionId String          @map("rubric_criterion_id")
  score             Int
  notes             String?
  assessedByUserId  String          @map("assessed_by_user_id")
  assessedAt        DateTime        @default(now()) @map("assessed_at")
  criterion         RubricCriterion @relation(fields: [rubricCriterionId], references: [id])
  assessedBy        User            @relation(fields: [assessedByUserId], references: [id])

  @@map("rubric_self_assessments")
}

model IsefCategory {
  id                   String  @id @default(cuid())
  name                 String
  description          String
  exampleSubtopicsJson Json    @map("example_subtopics_json")
  recommendedLabType   LabType @map("recommended_lab_type")

  @@map("isef_categories")
}

model FormsCatalog {
  id                    String           @id @default(cuid())
  name                  String
  formCode              String           @map("form_code")
  requiredForLevelsJson Json             @map("required_for_levels_json")
  templateUrl           String?          @map("template_url")
  description           String
  teamStatuses          TeamFormStatus[]

  @@map("forms_catalog")
}

model TeamFormStatus {
  id          String       @id @default(cuid())
  teamId      String       @map("team_id")
  formId      String       @map("form_id")
  status      FormStatus   @default(not_started)
  completedAt DateTime?    @map("completed_at")
  team        Team         @relation(fields: [teamId], references: [id])
  form        FormsCatalog @relation(fields: [formId], references: [id])

  @@unique([teamId, formId])
  @@map("team_form_status")
}

enum FormStatus {
  not_started
  in_progress
  complete

  @@map("form_status")
}

// ─── PvP Combat ──────────────────────────────────────────────────────────────

model Character {
  id         String          @id @default(cuid())
  buildingId String          @unique @map("building_id")
  name       String
  type       CombatType
  baseHp     Int             @map("base_hp")
  baseAtk    Int             @map("base_atk")
  baseDef    Int             @map("base_def")
  baseSpd    Int             @map("base_spd")
  sprite1Url String          @map("sprite_1_url")
  sprite2Url String          @map("sprite_2_url")
  building   Building        @relation(fields: [buildingId], references: [id])
  moves      CharacterMove[]

  @@map("characters")
}

enum CombatType {
  empirical
  theoretical
  applied

  @@map("combat_type")
}

model Move {
  id                  String          @id @default(cuid())
  name                String
  type                CombatType
  baseDamage          Int             @map("base_damage")
  accuracy            Int
  pp                  Int
  secondaryEffectJson Json?           @map("secondary_effect_json")
  flavorText          String          @map("flavor_text")
  characters          CharacterMove[]

  @@map("moves")
}

model CharacterMove {
  characterId  String    @map("character_id")
  moveId       String    @map("move_id")
  levelLearned Int       @map("level_learned")
  character    Character @relation(fields: [characterId], references: [id])
  move         Move      @relation(fields: [moveId], references: [id])

  @@id([characterId, moveId])
  @@map("character_moves")
}

model PvpTeam {
  id                 String   @id @default(cuid())
  teamId             String   @unique @map("team_id")
  characterSlotsJson Json     @map("character_slots_json")
  updatedAt          DateTime @updatedAt @map("updated_at")
  team               Team     @relation(fields: [teamId], references: [id])

  @@map("pvp_teams")
}

model PvpBattle {
  id                    String       @id @default(cuid())
  attackerTeamId        String       @map("attacker_team_id")
  defenderTeamId        String       @map("defender_team_id")
  phase                 ProjectPhase
  startedAt             DateTime     @default(now()) @map("started_at")
  endedAt               DateTime?    @map("ended_at")
  winnerTeamId          String?      @map("winner_team_id")
  trophiesDeltaAttacker Int?         @map("trophies_delta_attacker")
  trophiesDeltaDefender Int?         @map("trophies_delta_defender")
  battleLogJson         Json?        @map("battle_log_json")

  @@map("pvp_battles")
}

model PvpTrophies {
  teamId          String   @id @map("team_id")
  currentTrophies Int      @default(0) @map("current_trophies")
  tier            PvpTier  @default(bronze)
  season          Int      @default(1)
  updatedAt       DateTime @updatedAt @map("updated_at")
  team            Team     @relation(fields: [teamId], references: [id])

  @@map("pvp_trophies")
}

enum PvpTier {
  bronze
  silver
  gold
  platinum
  diamond
  master

  @@map("pvp_tier")
}

model PvpBattleQuota {
  teamId      String   @map("team_id")
  date        DateTime @db.Date
  battlesUsed Int      @default(0) @map("battles_used")
  team        Team     @relation(fields: [teamId], references: [id])

  @@id([teamId, date])
  @@map("pvp_battle_quota")
}

// ─── Activity Feed ───────────────────────────────────────────────────────────

model ActivityFeed {
  id          String   @id @default(cuid())
  teamId      String   @map("team_id")
  userId      String   @map("user_id")
  actionType  String   @map("action_type")
  payloadJson Json     @map("payload_json")
  createdAt   DateTime @default(now()) @map("created_at")
  team        Team     @relation(fields: [teamId], references: [id])
  user        User     @relation(fields: [userId], references: [id])

  @@index([teamId, createdAt])
  @@map("activity_feed")
}
